# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch / one-off scripts (kept on disk, never committed)
_auth.mjs
_dbg.mjs
_modal.mjs
_upload.mjs
_probe.jpg
fix7.mjs
temp_run.mjs
temp_team.sql
test_team.sql
tmp.ps1
*.zip

# runtime uploads (Render filesystem is ephemeral; images live as https links)
/storage/
