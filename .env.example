# PostgreSQL connection string.
# Create the database first, then run:
#   psql "$DATABASE_URL" -f db/schema.sql
#   psql "$DATABASE_URL" -f db/seed.sql
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agati"

# Set to "true" if your host requires TLS (e.g. Neon, Supabase, RDS).
PGSSL="false"

# Max pooled connections per server process.
PGPOOL_MAX="10"

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# Secret used to sign admin session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Change this before deploying anywhere public.
JWT_SECRET="replace-me-with-a-long-random-string"

# Session lifetime in seconds (default 8 hours).
SESSION_TTL="28800"

# Seeded on the first `npm run db:admin`. Change the password afterwards.
ADMIN_EMAIL="admin@agati.com"
ADMIN_PASSWORD="change-me-before-deploying"
ADMIN_NAME="Super Admin"

# ---------------------------------------------------------------------------
# Image storage (Cloudinary)
# ---------------------------------------------------------------------------
# Uploaded images are stored in Cloudinary and the full HTTPS URL is saved in
# PostgreSQL, so pictures survive redeploys on hosts with an ephemeral
# filesystem (Render, Vercel, ...). Without these three variables an upload is
# refused in production; in development it falls back to the local disk.
# Find them on https://console.cloudinary.com -> Dashboard -> API keys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

